<!-- views/register.ejs -->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Google Font: Prompt -->
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome ไอคอน -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            font-family: 'Prompt', sans-serif;
            background: linear-gradient(135deg, #ffe5ec 0%, #e3f2fd 100%);
            margin: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .register-card {
            background: #ffffff;
            border-radius: 25px;
            box-shadow: 0 15px 35px rgba(255, 182, 193, 0.25);
            border: 3px solid #fff0f3;
            position: relative;
            overflow: hidden;
        }
        .register-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 8px;
            background: linear-gradient(90deg, #ffb6c1, #92c9ff, #bde0fe);
        }
        .form-control, .form-select {
            border-radius: 50px;
            padding: 10px 20px;
            font-size: 0.9rem;
            border: 2px solid #f1f1f1;
            background-color: #fafafa;
        }
        .form-control:focus, .form-select:focus {
            background-color: #ffffff;
            box-shadow: 0 0 0 4px rgba(255, 182, 193, 0.2);
            border-color: #ffb6c1;
        }
        .btn-custom-register {
            background: linear-gradient(135deg, #ffb6c1 0%, #ff9aa2 100%);
            color: #ffffff;
            border-radius: 50px;
            padding: 12px;
            font-weight: 600;
            border: none;
            box-shadow: 0 4px 15px rgba(255, 154, 162, 0.4);
            transition: all 0.3s ease;
        }
        .btn-custom-register:hover {
            background: linear-gradient(135deg, #ff9aa2 100%, #ff7b88 100%);
            color: #ffffff;
            transform: translateY(-2px);
        }
        .text-pastel-pink { color: #ff7b88; }
        .text-pastel-blue { color: #4a90e2; }
    </style>
</head>
<body>

<!-- เรียกใช้งาน Header Partial ที่อัปเดตแล้ว -->
<%- include('partials/header') %>

<!-- ส่วนฟอร์มสมัครสมาชิกหลัก -->
<main class="container d-flex flex-column justify-content-center align-items-center my-auto py-5 flex-grow-1">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="register-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="mb-2" style="font-size: 2.2rem;">📝✨</div>
                    <h2 class="fw-bold mb-1" style="color: #4a4a4a;">สร้างบัญชีผู้ใช้ใหม่</h2>
                    <p class="text-muted" style="font-size: 0.9rem;">มาร่วมเป็นส่วนหนึ่งกับครอบครัว "เที่ยวกับฟ้า" กันเถอะ!</p>
                </div>

                <form action="/register" method="POST">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="firstname" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">
                                <i class="fas fa-user me-1 text-pastel-pink"></i> ชื่อจริง
                            </label>
                            <input type="text" class="form-control" id="firstname" name="firstname" placeholder="กรอกชื่อจริง" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="lastname" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">
                                <text class="fas fa-user me-1 text-pastel-pink"></text> นามสกุล
                            </label>
                            <input type="text" class="form-control" id="lastname" name="lastname" placeholder="กรอกนามสกุล" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">
                            <i class="fas fa-envelope me-1 text-pastel-blue"></i> อีเมล
                        </label>
                        <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="password" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">
                                <i class="fas fa-lock me-1 text-pastel-pink"></i> รหัสผ่าน
                            </label>
                            <input type="password" class="form-control" id="password" name="password" placeholder="อย่างน้อย 6 ตัวอักษร" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="phone" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">
                                <i class="fas fa-phone me-1 text-pastel-blue"></i> เบอร์โทรศัพท์
                            </label>
                            <input type="tel" class="form-control" id="phone" name="phone" placeholder="0891234567">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="travelStyle" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">
                            <i class="fas fa-plane-departure me-1 text-pastel-pink"></i> สไตล์การท่องเที่ยวที่ชื่นชอบ
                        </label>
                        <select class="form-select" id="travelStyle" name="travelStyle">
                            <option value="cafe">คาเฟ่ & ร้านอาหารชิคๆ</option>
                            <option value="nature">ธรรมชาติ & ภูเขา</option>
                            <option value="sea">ทะเล & ดำน้ำ</option>
                            <option value="culture">วัฒนธรรม & ชุมชนเก่า</option>
                        </select>
                    </div>

                    <div class="form-check mb-4" style="font-size: 0.85rem;">
                        <input class="form-check-input" type="checkbox" id="terms" name="terms" required style="accent-color: #ff9aa2;">
                        <label class="form-check-label text-muted" for="terms">
                            ฉันยอมรับ <a href="#" class="text-pastel-pink text-decoration-none">เงื่อนไขการใช้งานและนโยบายความเป็นส่วนตัว</a>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-custom-register w-100 mb-3">
                        <i class="fas fa-heart me-1"></i> ลงทะเบียนสมัครสมาชิก
                    </button>
                </form>
            </div>
        </div>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>