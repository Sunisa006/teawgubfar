    <style>
        body {
            font-family: 'Prompt', sans-serif;
            background-color: #f8d7da;
            margin: 0;
        }

        .search-box-container {
            background-color: #ffffff;
            border-radius: 50px;
            padding: 8px 20px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            max-width: 600px;
            margin: 0 auto;
        }

        .attraction-card {
            background: transparent;
            border: none;
            transition: transform 0.2s;
        }

        .attraction-card:hover {
            transform: translateY(-5px);
        }

        .attraction-img {
            height: 180px;
            object-fit: cover;
            border-radius: 12px;
        }

        /* สไตล์สำหรับปุ่ม Pagination */
        .pagination-dots {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            background-color: #f43f5e;
            color: #ffffff;
            font-weight: 600;
            border-radius: 50%;
            text-decoration: none;
            transition: all 0.3s;
        }

        .pagination-dots.inactive {
            background-color: #ffffff;
            color: #475569;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        .pagination-dots.inactive:hover {
            background-color: #e2e8f0;
            color: #1e293b;
