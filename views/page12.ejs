}

.attraction-img {
    height: 180px;
    object-fit: cover;
    border-radius: 12px;
}

/* สไตล์สำหรับปุ่ม Pagination */
.pagination-dots {
    display: inline-flex;
    align-items: center;
    justify-content: center;
