    background-color: #f43f5e;
    color: #ffffff;
    font-weight: 600;
    border-radius: 50%;
    text-decoration: none;
    transition: all 0.3s;
}

.pagination-dots.inactive {
    background-color: #ffffff;
    color: #475569;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

.pagination-dots.inactive:hover {
    background-color: #e2e8f0;
    color: #1e293b;
}
